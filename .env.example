# Mini-JuriNex — Environment Variables
# Copy this to .env and fill in actual values. Do NOT commit .env.
#
# Adapted from auxillary/Lawapp_Project/starter_repo/.env.example.
# Removed (unused under the free-tier substitutions in CLAUDE.md):
#   GCP_PROJECT_ID, GCS_BUCKET_NAME, GOOGLE_APPLICATION_CREDENTIALS  -> D-001 / D-004
#   CHROMA_PERSIST_DIR, VERTEX_INDEX_ENDPOINT, VERTEX_DEPLOYED_INDEX_ID -> FAISS (§4.5 permits)
#   ADMIN_TOKEN -> indexing is the CLI form (03_backend_spec.md §339), not the admin endpoint
# Added:
#   EVAL_TOKEN -> required by starter_repo/README.md for POST /api/v1/eval/retrieve,
#                 but missing from the starter's own .env.example
#   UPLOAD_DIR / SQLITE_PATH / CORPUS_INDEX_PATH -> local-disk + SQLite + FAISS paths
#   FRONTEND_BASE_URL -> the callback 302s back to the frontend (03_backend_spec.md §94)
#
# Model names are NOT env vars: they are pinned as constants in backend/config.py so a
# dashboard typo cannot silently swap the model.

# --- Google OAuth (Step 2) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Gemini (Step 1) ---
GEMINI_API_KEY=

# --- Session / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_SECRET=
JWT_EXPIRY_MINUTES=60

# --- Eval harness ---
# Static bearer token for POST /api/v1/eval/retrieve. Any long random string.
# Generate the same way as JWT_SIGNING_SECRET.
EVAL_TOKEN=

# --- Local storage (D-001 / D-004) ---
UPLOAD_DIR=./var/uploads
SQLITE_PATH=./var/lawapp.db

# --- Vector store (D-005: vectors committed, loaded at startup) ---
CORPUS_INDEX_PATH=../data/corpus_index.json

# --- URLs ---
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
