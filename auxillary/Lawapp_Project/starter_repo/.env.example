# Mini-JuriNex — Environment Variables
# Copy this to .env and fill in actual values. Do NOT commit .env.

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Gemini ---
GEMINI_API_KEY=

# --- GCP ---
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Session / JWT ---
# Only needed if using JWT session model
JWT_SIGNING_SECRET=
JWT_EXPIRY_MINUTES=60

# --- Vector store ---
# For ChromaDB (persistent on disk)
CHROMA_PERSIST_DIR=./chroma_data
# For Vertex Vector Search, use GCP_PROJECT_ID above + index endpoint
VERTEX_INDEX_ENDPOINT=
VERTEX_DEPLOYED_INDEX_ID=

# --- Admin ---
ADMIN_TOKEN=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
